pipeline {
    agent {
        docker {
            image 'node:lts-buster-slim' 
            args '-p 3000:3000'
        }
    }

    stages {
        stage('Build') {
            steps {
                echo 'Memulai proses Build...'
                sh 'npm install'
            }
        }
        stage('Test') {
            steps {
                echo 'Memulai proses Test...'
                sh 'npm test'
            }
        }
    }
}
